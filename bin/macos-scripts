#!/bin/zsh
# filepath: bin/macos-scripts

set -e
set -u
set -o pipefail

MACOS_SCRIPTS_VERSION="0.2.0"

SCRIPT_PATH="${0:P}"
BIN_DIR="${SCRIPT_PATH:h}"
REPO_ROOT="${MACOS_SCRIPTS_ROOT:-${BIN_DIR:h}}"
MACOS_SCRIPTS_LOG_DIR="${MACOS_SCRIPTS_LOG_DIR:-$HOME/Library/Logs/macos-scripts}"
MACOS_SCRIPTS_CONFIG_DIR="${MACOS_SCRIPTS_CONFIG_DIR:-$HOME/.config/macos-scripts}"

mkdir -p "$MACOS_SCRIPTS_LOG_DIR" "$MACOS_SCRIPTS_CONFIG_DIR"

export MACOS_SCRIPTS_ROOT="$REPO_ROOT"
export MACOS_SCRIPTS_LOG_DIR
export MACOS_SCRIPTS_CONFIG_DIR

# CLI layering:
# 1) help text/router
# 2) shared runtime + forwarding glue
# 3) validators
# 4) top-level dispatch
source "$REPO_ROOT/lib/colors.sh"
source "$REPO_ROOT/bin/lib/help.sh"
# shellcheck disable=SC1091
source "$REPO_ROOT/bin/lib/cli_runtime.sh"
# shellcheck disable=SC1091
source "$REPO_ROOT/bin/lib/cli_forward_args.sh"
# shellcheck disable=SC1091
source "$REPO_ROOT/bin/lib/validators.sh"
# shellcheck disable=SC1091
source "$REPO_ROOT/bin/lib/cli_dispatch.sh"

main "$@"
