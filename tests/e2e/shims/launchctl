#!/bin/bash
# filepath: tests/e2e/shims/launchctl
# launchctl 命令桩：记录调用；模拟“任务未加载”（print 返回 1），
# 使 job create 走 bootstrap 路径、job disable 提示未运行。
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_recorder.sh"

record_invocation "$@"

case "${1:-}" in
  print)
    # 任务未加载 -> job create 走 bootstrap；job disable 提示未运行
    exit 1
    ;;
  *)
    exit 0
    ;;
esac
