#!/bin/zsh
set -u
# filepath: tests/e2e/shims/macos-scripts
# macos-scripts 命令桩：支持 CLI 版本检查及故障注入。
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_recorder.sh"

record_invocation "$@"
if [[ -n "${E2E_CLI_EXPECT_LOG_DIR:-}" && "${MACOS_SCRIPTS_LOG_DIR:-}" != "$E2E_CLI_EXPECT_LOG_DIR" ]]; then
  printf 'CLI did not inherit the unified log directory\n' >&2
  exit 8
fi
if [[ "${1:-}" == --version ]]; then
  if [[ "${E2E_CLI_VERSION_STATUS:-0}" != 0 ]]; then
    printf 'CLI version check failed (e2e stub)\n' >&2
    exit "$E2E_CLI_VERSION_STATUS"
  fi
  printf '%s\n' "${E2E_CLI_VERSION_OUTPUT:-macos-scripts 0.5.0 (e2e stub)}"
  exit 0
fi
if [[ "${1:-}" == setup && "${2:-}" == brew && "${3:-}" == configure ]]; then
  exit "${E2E_CLI_CONFIG_STATUS:-0}"
fi
printf 'macos-scripts e2e stub\n'
exit 0
