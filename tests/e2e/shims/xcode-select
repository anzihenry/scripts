#!/bin/bash
# filepath: tests/e2e/shims/xcode-select
# xcode-select 命令桩：记录调用，模拟 Xcode CLI 已就绪（-p 返回 0）。
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_recorder.sh"

record_invocation "$@"

case "${1:-}" in
  -p)
    printf '/Library/Developer/CommandLineTools\n'
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
