#!/bin/bash
set -u
# filepath: tests/e2e/shims/xcode-select
# xcode-select 命令桩：记录调用，模拟 Xcode CLI 已就绪（-p 返回 0）。
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_recorder.sh"

record_invocation "$@"

case "${1:-}" in
  -p)
    printf '/Library/Developer/CommandLineTools\n'
    exit 0
    ;;
  --install)
    exit 0
    ;;
  *)
    # fail loud：未建模的子命令不应被静默放过。
    printf 'xcode-select stub: 未支持的命令: %s\n' "${1:-}" >&2
    exit 127
    ;;
esac
