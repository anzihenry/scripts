#!/bin/bash
set -u
# filepath: tests/e2e/shims/gh
# gh 命令桩：记录调用，并用 $E2E_GH_STATE_DIR/release_created 标记模拟
# release 是否已存在（gh release create 成功后会写入标记，使后续 api 查询返回已存在）。
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_recorder.sh"

record_invocation "$@"

GH_STATE_DIR="${E2E_GH_STATE_DIR:-${E2E_TMP_ROOT:-/tmp}/gh_state}"
mkdir -p "$GH_STATE_DIR"

release_created() { [[ -f "$GH_STATE_DIR/release_created" ]]; }

cmd="${1:-}"
sub="${2:-}"
shift 2 2> /dev/null || true

case "$cmd" in
  api)
    if release_created; then
      printf '%s\n' "https://github.com/anzihenry/scripts/releases/tag/${E2E_GH_TAG:-v0.5.0}"
      exit 0
    fi
    # 贴近真实 gh：release 不存在时 api 返回 404（gh 文案为 "HTTP 404: Not Found"）
    printf 'gh: Not Found (HTTP 404)\n' >&2
    exit 1
    ;;
  auth)
    # gh auth status / gh auth login：E2E 默认视为已登录
    exit 0
    ;;
  release)
    case "$sub" in
      create)
        : > "$GH_STATE_DIR/release_created"
        printf '%s\n' "https://github.com/anzihenry/scripts/releases/tag/${E2E_GH_TAG:-v0.5.0}"
        exit 0
        ;;
      edit)
        exit 0
        ;;
      *)
        printf 'gh stub: 未支持的 release 子命令: %s\n' "$sub" >&2
        exit 127
        ;;
    esac
    ;;
  *)
    # fail loud：不再静默 exit 0，避免「生产代码调用了未建模的命令却测试通过」的假绿。
    printf 'gh stub: 未支持的命令: %s %s\n' "$cmd" "$sub" >&2
    exit 127
    ;;
esac
